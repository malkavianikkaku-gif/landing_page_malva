---
import { Image } from 'astro:assets';
import malvavyscoIconPre from '../assets/images/Icons/malvavyscoIcon.png';
---
<header class="fixed top-0 left-0 w-full z-50 bg-brand-dark/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    
    <!-- Logo / Marca -->
    <a href="#hero" class="text-xl font-bold text-white tracking-wide flex items-center gap-2">
      <span class="text-brand-purple">&lt;</span><Image src={malvavyscoIconPre} alt="Logo Malvavysco" width="32" height="32" loading="eager"/>Malvavysco<span class="text-brand-purple">/&gt;</span>
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm text-gray-300 font-medium">
      <a href="#proyectos" class="hover:text-brand-purple transition-colors">Proyectos</a>
      <a href="#habilidades" class="hover:text-brand-purple transition-colors">Habilidades</a>
      <a href="#certificaciones" class="hover:text-brand-purple transition-colors">Certificaciones</a>
      <a href="#contacto" class="hover:text-brand-purple transition-colors">Contacto</a>
    </nav>

    <!-- Botón Hambuguesa (Móvil) -->
    <button id="menu-btn" aria-label="Abrir menú" class="md:hidden text-white p-2 focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden bg-brand-card border-b border-white/10 px-4 pt-2 pb-6 space-y-3 text-sm text-gray-300">
    <a href="#proyectos" class="block hover:text-brand-purple transition-colors py-1">Proyectos</a>
    <a href="#habilidades" class="block hover:text-brand-purple transition-colors py-1">Habilidades</a>
    <a href="#certificaciones" class="block hover:text-brand-purple transition-colors py-1">Certificaciones</a>
    <a href="#contacto" class="block hover:text-brand-purple transition-colors py-1">Contacto</a>
  </div>
  <div class="header-laser-line"></div>
</header>
<style>
  .header-laser-line {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1.5px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(139, 92, 246, 0) 20%,
      #8b5cf6 45%,
      #3b82f6 50%,
      #ec4899 55%,
      rgba(139, 92, 246, 0) 80%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: laser-sweep 4s linear infinite;
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.8), 0 0 5px rgba(59, 130, 246, 0.8);
  }

  @keyframes laser-sweep {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Cerrar menú al hacer clic en cualquier link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });
</script>