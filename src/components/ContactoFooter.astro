---
const currentYear = new Date().getFullYear();
---

<section id="contacto" class="py-20 px-4 max-w-6xl mx-auto border-t border-white/10">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start mb-16">
    
    <!-- Columna Izquierda: Información de contacto -->
    <div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        ¿Tienes un proyecto en mente? <br />
        <span class="text-brand-purple">Hablemos.</span>
      </h2>
      <p class="text-gray-400 mb-8 leading-relaxed">
        Estoy disponible para proyectos freelance, consultoría o roles Full-Stack. Si buscas crear una aplicación web moderna, automatizar procesos o integrar APIs, envíame un mensaje.
      </p>

      <div class="space-y-4">
        <a 
          href="mailto:fhazaelfcmalva@gmail.com" 
          class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-brand-purple/10 border border-brand-purple/30 flex items-center justify-center text-brand-purple group-hover:bg-brand-purple group-hover:text-white transition-all">
            ✉️
          </div>
          <div>
            <p class="text-xs text-gray-400">Correo directo</p>
            <p class="font-medium text-sm">Contacto por Email</p>
          </div>
        </a>

        <a 
          href="https://github.com/malkavianikkaku-gif" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-brand-purple/10 border border-brand-purple/30 flex items-center justify-center text-brand-purple group-hover:bg-brand-purple group-hover:text-white transition-all">
            💻
          </div>
          <div>
            <p class="text-xs text-gray-400">GitHub</p>
            <p class="font-medium text-sm">github.com/malvavysco</p>
          </div>
        </a>

        <a 
          href="https://www.linkedin.com/in/hazael-castrejon-75a10737b" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-brand-purple/10 border border-brand-purple/30 flex items-center justify-center text-brand-purple group-hover:bg-brand-purple group-hover:text-white transition-all">
            💼
          </div>
          <div>
            <p class="text-xs text-gray-400">LinkedIn</p>
            <p class="font-medium text-sm">Perfil Profesional</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Formulario -->
    <div class="bg-brand-card/60 border border-white/10 p-6 md:p-8 rounded-xl">
      <form action="https://formspree.io/f/tu_form_id" method="POST" class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-medium text-gray-300 mb-1">Nombre</label>
          <input 
            type="text" 
            id="name"
            name="name" 
            required 
            placeholder="Tu nombre o empresa"
            class="w-full bg-black/40 border border-white/10 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple transition-colors text-sm"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-medium text-gray-300 mb-1">Correo Electrónico</label>
          <input 
            type="email"
            id="email"
            name="email" 
            required 
            placeholder="tu@email.com"
            class="w-full bg-black/40 border border-white/10 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple transition-colors text-sm"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-medium text-gray-300 mb-1">Mensaje</label>
          <textarea 
            id="message"
            name="message" 
            rows="4" 
            required 
            placeholder="Cuéntame sobre tu proyecto o consulta..."
            class="w-full bg-black/40 border border-white/10 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple transition-colors text-sm resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 bg-brand-purple hover:opacity-90 text-white font-medium rounded-lg transition-all duration-200 text-sm"
        >
          Enviar mensaje
        </button>
      </form>
    </div>

  </div>

  <!-- Footer Final -->
  <footer class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between text-xs text-gray-500 gap-4">
    <p>© {currentYear} Malvavysco. Diseñado y construido con Astro & Tailwind CSS.</p>
    <div class="flex gap-6">
      <a href="#hero" class="hover:text-gray-300 transition-colors">Volver arriba ↑</a>
    </div>
  </footer>
</section>