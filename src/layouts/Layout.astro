---
import '../styles/global.css';
import Proyectos from '../components/proyectos.astro';
import ContactoFooter from '../components/ContactoFooter.astro';
import Habilidades from '../components/Habilidades.astro';
import Header from '../components/Header.astro';
import Certificaciones from '../components/Certificaciones.astro';
import BackgroundCanvas from '../components/BackgrounCanvas.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-brand-dark text-white min-h-screen">
		<BackgroundCanvas />
		<Header />

		<slot />

		<ContactoFooter />
	</body>
</html>




